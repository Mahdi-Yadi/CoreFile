<Window x:Class="CoreFile.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="CoreFile"
        Width="1240"
        Height="780"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMain}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Vazirmatn"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        xmlns:converters="clr-namespace:CoreFile.Converters"
        UseLayoutRounding="True">
    
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Styles/WindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
                <Button Grid.Column="0" Style="{StaticResource ModernNavButton}" ToolTip="Back" Command="{Binding GoBackCommand}">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource FluentIcon}"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ModernNavButton}" ToolTip="Forward" Command="{Binding GoForwardCommand}">
                    <TextBlock Text="&#xE72A;" Style="{StaticResource FluentIcon}"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ModernNavButton}" Margin="2,0,8,0" ToolTip="Refresh" Command="{Binding RefreshCommand}">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}"/>
                </Button>

                <!-- Address Bar -->
                <Border Grid.Column="3" Height="32" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE8B9;" Style="{StaticResource FluentIcon}" Foreground="{DynamicResource TextSecondary}" Margin="8,0,6,0" FontSize="12"/>
                        <TextBox Grid.Column="1" Text="{Binding CurrentPath}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="2,0" Foreground="{DynamicResource TextPrimary}" FontSize="12.5"/>
                    </Grid>
                </Border>

                <!-- Search Box Section (افزوده شدن IsHitTestVisibleInChrome) -->
                <StackPanel Grid.Column="3" 
                    Orientation="Horizontal" 
                    Margin="10,5" 
                    HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="{DynamicResource BgPanel}" 
                    CornerRadius="4" 
                    BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="1" 
                    Width="250" 
                    Height="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" 
                               VerticalAlignment="Center" 
                               Margin="8,0,5,0" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" 
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             VerticalAlignment="Center" 
                             Foreground="{DynamicResource TextPrimary}"
                             Padding="2,0"/>
                            <Button Grid.Column="2" 
                            Command="{Binding ClearSearchCommand}" 
                            Content="✕" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{DynamicResource TextSecondary}" 
                            Margin="0,0,5,0"
                            Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <CheckBox Content="Deep Search" 
                      IsChecked="{Binding IsDeepSearchEnabled}" 
                      VerticalAlignment="Center" 
                      Margin="10,0,0,0" 
                      Foreground="{DynamicResource TextPrimary}"/>

                    <ProgressBar IsIndeterminate="True" 
                         Width="60" Height="4" 
                         Margin="10,0,0,0" 
                         VerticalAlignment="Center">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>

                <!-- Settings Button (بدون پس‌زمینه و شفاف) -->
                <ToggleButton x:Name="SettingsButton" 
                      Grid.Column="4" 
                      Width="34" 
                      Height="32" 
                      Margin="8,0,8,0" 
                      Background="Transparent"
                      BorderThickness="0"
                      ToolTip="Settings" 
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}"/>
                </ToggleButton>

                <!-- Window Controls -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" Style="{StaticResource FluentIcon}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize">
                        <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" Style="{StaticResource FluentIcon}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource FluentIcon}" FontSize="10"/>
                    </Button>
                </StackPanel>

                <!-- Settings Popup -->
                <Popup IsOpen="{Binding IsChecked, ElementName=SettingsButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Width="200" Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Theme Settings" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" FontSize="13"/>
                            <RadioButton Content="Light Mode" IsChecked="{Binding IsDarkMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" 
                                 Command="{Binding ToggleThemeCommand}" CommandParameter="Light" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <RadioButton Content="Dark Mode" IsChecked="{Binding IsDarkMode}" 
                                 Command="{Binding ToggleThemeCommand}" CommandParameter="Dark" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MaxWidth="500" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0" Padding="4,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="This PC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Drives}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarDriveButton}"
                                        Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource BgMain}" Padding="6">
                <ListView ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          SelectionMode="Extended"
                          SelectionChanged="FilesList_SelectionChanged"
                          BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextPrimary}"
                          MouseDoubleClick="FilesList_MouseDoubleClick"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <GridViewRowPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgSecondary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.InputBindings>
                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}"/>
                        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}"/>
                        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}"/>
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                    </ListView.InputBindings>

                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="{Binding CopyCommand}"/>
                            <MenuItem Header="Cut" Command="{Binding CutCommand}"/>
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}"/>
                            <Separator/>
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="280">
                                <GridViewColumn.Header>
                                    <Button Content="Name" Style="{StaticResource SortableHeaderButton}" 
                                            Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
                                            CommandParameter="Name"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="110">
                                <GridViewColumn.Header>
                                    <Button Content="Type" Style="{StaticResource SortableHeaderButton}" 
                                            Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
                                            CommandParameter="Type"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="100">
                                <GridViewColumn.Header>
                                    <Button Content="Size" Style="{StaticResource SortableHeaderButton}" 
                                            Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
                                            CommandParameter="Size"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="140">
                                <GridViewColumn.Header>
                                    <Button Content="Date Modified" Style="{StaticResource SortableHeaderButton}" 
                                            Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
                                            CommandParameter="ModifiedDate"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedDate, StringFormat={}{0:yyyy/MM/dd HH:mm}}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <GridSplitter Grid.Column="2" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColor}"/>
            <Border Grid.Column="3" 
                    Background="{DynamicResource BgPanel}" 
                    BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding SelectedItem.Name}" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" 
                               Margin="0,0,0,16"/>

                    <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource BgMain}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8"
                            Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource BgMain}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8"
                            Visibility="{Binding IsTextPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding PreviewText}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas, Cascadia Code" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource BgMain}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16"
                            Visibility="{Binding IsMediaPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource FluentIcon}" FontSize="48" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SelectedItem.Type, StringFormat={}{0} File}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding SelectedItem.SizeText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Height="4" Width="120" Value="{Binding OperationProgress}" Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>