<Window x:Class="CoreFile.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CoreFile"
        Width="1150"
        Height="720"
        MinWidth="850"
        MinHeight="550"
        Background="{DynamicResource BgMain}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="←" Width="36" Height="32" Margin="0,0,4,0" ToolTip="Back" Command="{Binding GoBackCommand}"/>
                <Button Grid.Column="1" Content="→" Width="36" Height="32" Margin="0,0,4,0" ToolTip="Forward" Command="{Binding GoForwardCommand}"/>
                <Button Grid.Column="2" Content="⟳" Width="36" Height="32" Margin="0,0,12,0" ToolTip="Refresh" Command="{Binding RefreshCommand}"/>

                <TextBox Grid.Column="3" Height="32" Padding="8,0" VerticalContentAlignment="Center" 
                         Text="{Binding CurrentPath}" IsReadOnly="True" 
                         Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}"/>

                <!-- دکمه تنظیمات -->
                <ToggleButton x:Name="SettingsButton" Grid.Column="4" Content="⚙" Width="36" Height="32" Margin="8,0,0,0" ToolTip="Settings"/>

                <!-- منوی کشویی تنظیمات (Theme Menu) -->
                <Popup IsOpen="{Binding IsChecked, ElementName=SettingsButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom">
                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12" Width="180">
                        <StackPanel>
                            <TextBlock Text="App Theme" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <RadioButton Content="Light Mode" IsChecked="{Binding IsDarkMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" 
                                         Command="{Binding ToggleThemeCommand}" CommandParameter="Light" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <RadioButton Content="Dark Mode" IsChecked="{Binding IsDarkMode}" 
                                         Command="{Binding ToggleThemeCommand}" CommandParameter="Dark" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MaxWidth="500" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar (Drives) -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="This PC" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="16,0"/>

                    <!-- کلید رفع باگ: HorizontalContentAlignment="Stretch" روی ListBox -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Drives}" BorderThickness="0" Background="Transparent" Padding="4"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- کلید رفع باگ: HorizontalAlignment="Stretch" روی Button -->
                                <Button Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" 
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Center View (Files Table) -->
            <Grid Grid.Column="1" Background="{DynamicResource BgPanel}">
                <ListView ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextPrimary}"
                          MouseDoubleClick="FilesList_MouseDoubleClick"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">

                    <ListView.InputBindings>
                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" CommandParameter="{Binding SelectedItem}"/>
                        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}"/>
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem}"/>
                    </ListView.InputBindings>

                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="{Binding CopyCommand}" CommandParameter="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Cut" Command="{Binding CutCommand}" CommandParameter="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}"/>
                            <Separator/>
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="90"/>
                            <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeText}" Width="90"/>
                            <GridViewColumn Header="Created" DisplayMemberBinding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                            <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding ModifiedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="2" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColor}"/>

            <!-- Right Sidebar (Preview Panel) -->
            <Border Grid.Column="3" 
                    Background="{DynamicResource BgPreview}" 
                    BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Preview" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding SelectedItem.Name}" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" 
                               Margin="0,0,0,16"/>

                    <!-- Image Preview -->
                    <Border Grid.Row="2" CornerRadius="6" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8"
                            Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Text Preview -->
                    <Border Grid.Row="2" CornerRadius="6" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8"
                            Visibility="{Binding IsTextPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding PreviewText}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Video Preview / General Placeholder -->
                    <Border Grid.Row="2" CornerRadius="6" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16"
                            Visibility="{Binding IsMediaPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SelectedItem.Type, StringFormat={}{0} File}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding SelectedItem.SizeText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                <ProgressBar Height="8" Width="120" Margin="12,0,0,0" Value="{Binding OperationProgress}" Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>