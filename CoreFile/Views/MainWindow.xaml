<Window x:Class="CoreFile.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CoreFile.ViewModels"
        xmlns:views="clr-namespace:CoreFile.Views.UserControls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="CoreFile"
        Width="1280" Height="800"
        MinWidth="950" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding AddNewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" CommandParameter="{Binding CurrentTab}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding GoBackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding GoForwardCommand}"/>
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding CreateFolderCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding OpenTerminalCommand}"/>
        <KeyBinding Key="F10" Command="{Binding ToggleDualPaneCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- استایل تب‌ها -->
        <Style x:Key="Win11TabItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MaxWidth" Value="220"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="12,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" 
                                           FontSize="13" Foreground="#EAB308" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}"/>

                                <Button Grid.Column="2" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                        Width="20" Height="20" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BgPanel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsOptionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BgMain}">
        <Grid.RowDefinitions>
            <!-- ۱. نوار تب‌ها و تایتل‌بار -->
            <RowDefinition Height="44"/>
            <!-- ۲. نوار ابزار و آدرس بار -->
            <RowDefinition Height="48"/>
            <!-- ۳. فضای کاری اصلی -->
            <RowDefinition Height="*"/>
            <!-- ۴. نوار وضعیت -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ۱. نوار تب‌ها -->
        <Grid Grid.Row="0" Background="{DynamicResource BgMain}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Accent}">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="#FFFFFF" 
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Win11TabItemStyle}" 
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"
                                         GroupName="AppTabs"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Width="30" Height="30" Background="Transparent" BorderThickness="0"
                        Content="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                        Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,2"
                        Command="{Binding AddNewTabCommand}" ToolTip="New Tab (Ctrl+T)"/>
            </StackPanel>

            <!-- کنترل‌های پنجره و تنظیمات تم -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <ToggleButton x:Name="SettingsBtn" Width="40" Height="32" Background="Transparent" BorderThickness="0"
                              Content="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12"
                              Foreground="{DynamicResource TextSecondary}" ToolTip="Settings &amp; Layout"/>

                <ToggleButton Width="40" Height="32" Background="Transparent" BorderThickness="0"
                              IsChecked="{Binding IsDualPaneEnabled, Mode=OneWay}"
                              Command="{Binding ToggleDualPaneCommand}"
                              Content="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="12"
                              Foreground="{DynamicResource TextSecondary}"
                              ToolTip="Toggle Dual Pane View (F10)"/>

                <Popup IsOpen="{Binding IsChecked, ElementName=SettingsBtn, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=SettingsBtn}"
                       Placement="Bottom" HorizontalOffset="-190" VerticalOffset="4">
                    <Border Width="240" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Appearance Theme" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <Button Content="Light" Height="28" Background="{DynamicResource BgSecondary}" BorderThickness="0" Margin="0,0,4,0"
                                        Command="{Binding ToggleThemeCommand}" CommandParameter="Light"/>
                                <Button Content="Dark" Height="28" Background="{DynamicResource BgSecondary}" BorderThickness="0" Margin="4,0,0,0"
                                        Command="{Binding ToggleThemeCommand}" CommandParameter="Dark"/>
                            </UniformGrid>

                            <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,12"/>

                            <TextBlock Text="Folder View Layout" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource SettingsOptionBtn}" Command="{Binding ChangeViewModeCommand}" CommandParameter="Details">
                                <TextBlock Text="Details (لیست کامل)"/>
                            </Button>
                            <Button Style="{StaticResource SettingsOptionBtn}" Command="{Binding ChangeViewModeCommand}" CommandParameter="LargeIcons">
                                <TextBlock Text="Large Icons (آیکون بزرگ)"/>
                            </Button>
                            <Button Style="{StaticResource SettingsOptionBtn}" Command="{Binding ChangeViewModeCommand}" CommandParameter="SmallIcons">
                                <TextBlock Text="Small Icons (آیکون کوچک)"/>
                            </Button>
                            <Button Style="{StaticResource SettingsOptionBtn}" Command="{Binding ChangeViewModeCommand}" CommandParameter="List">
                                <TextBlock Text="List (فهرست ساده)"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button Width="44" Height="32" Content="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}" Click="BtnMinimize_Click"/>
                <Button x:Name="BtnMax" Width="44" Height="32" Content="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}" Click="BtnMaximize_Click"/>
                <Button Width="44" Height="32" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- ۲. نوار ابزار (ToolbarControl) -->
        <views:ToolbarControl Grid.Row="1"/>

        <!-- ۳. فضای کاری اصلی -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- سایدبار سمت چپ (SidebarControl) -->
            <views:SidebarControl Grid.Column="0"/>

            <!-- فضای نمایش فایل‌ها (Dual Pane با FileExplorerControl) -->
            <Grid Grid.Column="1" Background="{DynamicResource BgPanel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*">
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="MaxWidth" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDualPaneEnabled}" Value="True">
                                        <Setter Property="MaxWidth" Value="Infinity"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- پنل ۱ (چپ) -->
                <Border Grid.Column="0" PreviewMouseDown="LeftPane_PreviewMouseDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDualPaneEnabled}" Value="True"/>
                                        <Condition Binding="{Binding IsRightPaneActive}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderThickness" Value="0,0,2,0"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <views:FileExplorerControl/>
                </Border>

                <!-- اسپلیتر متحرک -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource BorderColor}" ShowsPreview="False">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDualPaneEnabled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <!-- پنل ۲ (راست) -->
                <Border Grid.Column="2" Background="{DynamicResource BgPanel}" PreviewMouseDown="RightPane_PreviewMouseDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDualPaneEnabled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDualPaneEnabled}" Value="True"/>
                                        <Condition Binding="{Binding IsRightPaneActive}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource BgSecondary}" Padding="8,4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding SecondaryTab.Title, StringFormat='Pane 2: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>
                        <views:FileExplorerControl Grid.Row="1" DataContext="{Binding SecondaryTab}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- پنل پیش‌نمایش (PreviewPanelControl) -->
            <views:PreviewPanelControl Grid.Column="2"/>
        </Grid>

        <!-- ۴. نوار وضعیت -->
        <Border Grid.Row="3" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </Border>
    </Grid>
</Window>