<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- پس‌زمینه‌ها -->
    <SolidColorBrush x:Key="BgMain" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BgPreview" Color="#F8FAFC"/>

    <!-- خطوط و جداکننده‌ها -->
    <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

    <!-- متون -->
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>

    <!-- تعاملات (Hover / Selection / Accent) -->
    <SolidColorBrush x:Key="HoverBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#CCFBF1"/>
    <SolidColorBrush x:Key="Accent" Color="#0D9488"/>

</ResourceDictionary>