<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- پس‌زمینه‌ها -->
    <SolidColorBrush x:Key="BgMain" Color="#0F172A"/>
    <SolidColorBrush x:Key="BgPanel" Color="#1E293B"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#162032"/>
    <SolidColorBrush x:Key="BgPreview" Color="#111B2E"/>

    <!-- خطوط و جداکننده‌ها -->
    <SolidColorBrush x:Key="BorderColor" Color="#334155"/>

    <!-- متون -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>

    <!-- تعاملات (Hover / Selection / Accent) -->
    <SolidColorBrush x:Key="HoverBg" Color="#334155"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#134E4A"/>
    <SolidColorBrush x:Key="Accent" Color="#14B8A6"/>

</ResourceDictionary>