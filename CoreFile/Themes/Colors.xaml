<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- تم روشن (پیش‌فرض). متد ToggleTheme در MainViewModel همین کلیدها را در زمان اجرا جایگزین می‌کند. -->
    <SolidColorBrush x:Key="BgMain" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="BgPreview" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#222222"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>

    <!-- کلیدهای جدید -->
    <SolidColorBrush x:Key="HoverBg" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#DDF1EE"/>
    <SolidColorBrush x:Key="Accent" Color="#0F766E"/>

</ResourceDictionary>
